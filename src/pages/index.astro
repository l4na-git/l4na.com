---
import '../styles/global.css';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutSection from '../components/AboutSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ActivitiesSection from '../components/ActivitiesSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';

const siteUrl = new URL('/', Astro.site);
const ogImageUrl = new URL('/ogp.png', Astro.site);
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>l4na's portfolio</title>
		<meta name="description" content="l4naのポートフォリオサイトです。ITの専門学生として、エンジニアを目指しています。スキル、制作物、活動をまとめています。" />
		<link rel="canonical" href={siteUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="l4na's portfolio" />
		<meta property="og:title" content="l4na's portfolio" />
		<meta property="og:description" content="l4naのポートフォリオサイトです。ITの専門学生として、エンジニアを目指しています。スキル、制作物、活動をまとめています。" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="l4na's portfolio" />
		<meta name="twitter:description" content="l4naのポートフォリオサイトです。ITの専門学生として、エンジニアを目指しています。スキル、制作物、活動をまとめています。" />
		<meta name="twitter:image" content={ogImageUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Sawarabi+Gothic&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body class="min-h-screen relative">
		<!-- グリッド背景 -->
		<div class="grid-background fixed inset-0 -z-10 pointer-events-none"></div>
		<Header />
		<main>
			<HeroSection />
			<AboutSection />
			<SkillsSection />
			<ProjectsSection />
			<ActivitiesSection />
			<ContactSection />
		</main>
		<Footer />
	</body>
</html>
