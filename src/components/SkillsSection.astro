---
const skillCategories = [
  {
    title: "Frontend",
    skills: [
      { name: "HTML", level: 5, comment: "学校の授業で学びました。" },
      { name: "CSS", level: 4, comment: "TailwindCSSをよく使います" },
      { name: "JavaScript", level: 2, comment: "学校の授業で学びました。" },
      { name: "TypeScript", level: 1, comment: "参加しているプロジェクトで使用しているため、学習しています。" },
    ],
  },
  {
    title: "Backend",
    skills: [
      { name: "Node.js", level: 2, comment: "学校の授業で学びました。" },
      { name: "Python", level: 5, comment: "一番書くことが多いです。最近は機械学習やデータサイエンスを学ぶ際に使用しています。(paizaスキルチェック Aランク)" },
    ],
  },
  {
    title: "Infrastructure / Cloud",
    skills: [
      { name: "Linux", level: 3, comment: "自作サーバはUbuntu Serverです" },
      { name: "Docker", level: 3, comment: "自宅サーバはDockerで構築されています" },
      { name: "AWS", level: 2, comment: "EC2, S3, Lambda等触ったことがあります" },
      { name: "Google Cloud", level: 1, comment: "参加しているプロジェクトでCloud Loggingを使用しました。" },
      { name: "Cloudflare", level: 1, comment: "ドメイン管理やCloudflare Pagesでのサイト公開をしています。" },
    ],
  },
  {
    title: "Database",
    skills: [
      { name: "MySQL", level: 3, comment: "基本操作ができます(paizaSQLスキルチェック レベル4)" },
      { name: "SQLite", level: 2, comment: "Pythonと組み合わせて小規模なデータ管理に使用したことがあります。" },
    ],
  },
  {
    title: "Tools",
    skills: [
      { name: "GitHub", level: 4, comment: "チーム開発で使っています" },
      { name: "GitHub Actions", level: 1, comment: "参加しているプロジェクトで使用しているため、学習しながら書いています。" },
      { name: "Figma", level: 3, comment: "基本的な操作ができます" },
      { name: "Supabase", level: 3, comment: "ハッカソンで使用したことがあります。" },
    ],
  },
  {
    title: "Other",
    skills: [
      { name: "API連携", level: 3, comment: "REST APIを学校の授業で学びました" },
      { name: "セキュリティ", level: 2, comment: "たまにCTFに参加しています" },
      { name: "データサイエンス、機械学習", level: 1, comment: "学校の授業と、東京大学が主催しているGCIにて学習しています。" },
      { name: "基本情報技術者試験 合格", level: 5, comment: "現在は応用情報技術者試験を目指しています" },
    ],
  },
]
---

<section id="skills" class="py-20 px-4 md:px-8 lg:px-12">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-10">
      <p class="text-xs font-medium text-sky-dark uppercase tracking-widest mb-2">Skills</p>
      <h2 class="text-2xl md:text-3xl font-bold text-navy">
        スキル
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {skillCategories.map((category) => (
        <div class="bg-card rounded-2xl p-6 shadow-sm border border-border">
          <h3 class="text-sm font-semibold text-sky-dark uppercase tracking-wider mb-4">
            {category.title}
          </h3>
          <div class="flex flex-col">
            {category.skills.map((skill, index) => (
              <div class:list={[
                "flex flex-col gap-1 py-3",
                index !== category.skills.length - 1 ? "border-b border-border/60" : ""
              ]}>
                <div class="flex items-center justify-between">
                  <span class="text-sm font-medium text-navy">{skill.name}</span>
                  <div class="flex gap-1">
                    <span class="sr-only">レベル {skill.level}/5</span>
                    {[1, 2, 3, 4, 5].map((i) => (
                      <span
                        aria-hidden="true"
                        class:list={[
                          "w-2.5 h-2.5 rounded-full",
                          i <= skill.level ? "bg-sky-medium" : "bg-sky-light/60"
                        ]}
                      />
                    ))}
                  </div>
                </div>
                <p class="text-xs text-muted-foreground">{skill.comment}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
